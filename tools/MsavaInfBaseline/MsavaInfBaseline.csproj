<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This optional tool compiles exact, unmodified legacy source; mk8 analyzers apply to the main solution. -->
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSAVA_SOURCE_ROOT)/MSAVA-INF/Managers/FileManager.cs" Link="MSAVA/FileManager.cs" />
    <Compile Include="$(MSAVA_SOURCE_ROOT)/MSAVA-INF/Contexts/MetadataStore.cs" Link="MSAVA/MetadataStore.cs" />
    <Compile Include="$(MSAVA_SOURCE_ROOT)/MSAVA-INF/Models/SavedFileMetaRecord.cs" Link="MSAVA/SavedFileMetaRecord.cs" />
    <Compile Include="$(MSAVA_SOURCE_ROOT)/MSAVA-INF/Utils/FileContentUtils.cs" Link="MSAVA/FileContentUtils.cs" />
    <Compile Include="$(MSAVA_SOURCE_ROOT)/MSAVA-INF/Utils/StoredFileName.cs" Link="MSAVA/StoredFileName.cs" />
    <Compile Include="$(MSAVA_SOURCE_ROOT)/MSAVA-INF/Utils/TemporaryFileCleanup.cs" Link="MSAVA/TemporaryFileCleanup.cs" />
    <Compile Include="$(MSAVA_SOURCE_ROOT)/MSAVA-INF/Utils/FileStreamUtils.cs" Link="MSAVA/FileStreamUtils.cs" />
  </ItemGroup>
  <Target Name="RequireMsavaSource" BeforeTargets="CoreCompile">
    <Error Condition="'$(MSAVA_SOURCE_ROOT)' == '' or !Exists('$(MSAVA_SOURCE_ROOT)/MSAVA-INF/Managers/FileManager.cs')"
           Text="Set MSAVA_SOURCE_ROOT to a local MSAVA checkout before building this optional baseline." />
  </Target>
</Project>
