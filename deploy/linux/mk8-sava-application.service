[Unit]
Description=mk8.sava Application storage owner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mk8sava-application
Group=mk8sava-application
SupplementaryGroups=mk8sava-rpc
WorkingDirectory=/opt/mk8-sava/current/Application
EnvironmentFile=/etc/mk8-sava/policy.env
EnvironmentFile=/etc/mk8-sava/application.env
ExecStart=/opt/mk8-sava/current/Application/Mk8.Sava.Application
Restart=on-failure
RestartSec=2
TimeoutStopSec=60
KillMode=control-group
UMask=0077
StateDirectory=mk8-sava-application
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
