# Root-owned mode 0600. Application alone receives data-encryption keys.
# For an upgrade, preserve the EXISTING data path and effective data keys.
Sava__DataPath=/var/lib/mk8-sava-application
Sava__DataEncryptionKeys__replaceaccount=REPLACE_WITH_EXISTING_DATA_KEY_BASE64
ApplicationHosting__MaximumReadSessions=256
ApplicationHosting__ReadSessionIdleTimeout=00:02:00
ApplicationHosting__MaximumConcurrentRpcRequests=16
ApplicationHosting__MaximumQueuedRpcRequests=128
ApplicationHosting__RpcQueueTimeout=00:00:10
# Touch/Close/readiness use a separate fixed 4-active/32-queued, 4 KiB lane.
# Remote deployment ONLY: configure HTTPS Endpoint and a protected PFX file.
# ApplicationHosting__CertificateFile=/etc/mk8-sava/application.pfx
# ApplicationHosting__CertificatePassword=REPLACE_WITH_PFX_PASSWORD
