# Root-owned mode 0600. PID 1 reads this file for both services.
# Replace every placeholder. No public emulator credential is a production key.
Sava__DefaultAccount=replaceaccount
Sava__Accounts__replaceaccount=REPLACE_WITH_EXISTING_ACCOUNT_KEY_BASE64
Sava__AllowAnonymousPublicAccess=false
Sava__MaximumRequestBodyBytes=5242880000
# Add the same account capabilities, replication and Bearer policy on both hosts.
ApplicationTransport__Endpoint=http://127.0.0.1:18581/internal/application
ApplicationTransport__AccessKeyFile=/etc/mk8-sava/application-access.key
ApplicationTransport__ConnectTimeout=00:00:05
ApplicationTransport__RequestTimeout=00:10:00
ApplicationTransport__MaximumControlFrameBytes=67108864
