# Root-owned mode 0600. Gateway does not receive data-encryption keys.
ASPNETCORE_URLS=http://127.0.0.1:18580
Gateway__StagingPath=/var/cache/mk8-sava-gateway/staging
Gateway__MaximumConcurrentRequests=32
Gateway__MaximumQueuedRequests=128
Gateway__MaximumStagingBytes=10737418240
# Public listener/TLS is an explicit ingress decision; loopback is the default.
# Configure Kestrel HTTPS certificates when remote clients require HTTPS.
# Do not trust client-supplied forwarding headers to set the original scheme/IP.
