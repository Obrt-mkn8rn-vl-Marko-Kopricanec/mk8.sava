<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Mk8.Sava.Tests.RepositoryRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..</_Parameter2>
    </AssemblyAttribute>
    <EmbeddedResource Include="../Mk8.Sava.slnx" LogicalName="Mk8.Sava.Tests.Source.Mk8.Sava.slnx" />
    <EmbeddedResource Include="../Directory.Build.targets" LogicalName="Mk8.Sava.Tests.Source.Directory.Build.targets" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="22.1.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.0-beta.2" />
    <PackageReference Include="Azure.Storage.Blobs.Batch" Version="12.27.0-beta.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.analyzers" Version="2.1.0" PrivateAssets="all" Condition="'$(Mk8StrictAnalyzers)' == 'true'" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mk8.Sava.API/Mk8.Sava.API.csproj" />
    <ProjectReference Include="../Mk8.Sava.Gateway/Mk8.Sava.Gateway.csproj" />
    <ProjectReference Include="../Mk8.Sava.Application/Mk8.Sava.Application.csproj" />
    <ProjectReference Include="../Mk8.Sava.Transport/Mk8.Sava.Transport.csproj" />
    <ProjectReference Include="../Mk8.Sava.BLL/Mk8.Sava.BLL.csproj" />
    <ProjectReference Include="../Mk8.Sava.Contracts/Mk8.Sava.Contracts.csproj" />
    <ProjectReference Include="../Mk8.Sava.DAL/Mk8.Sava.DAL.csproj" />
    <ProjectReference Include="../Mk8.Sava.INF/Mk8.Sava.INF.csproj" />
  </ItemGroup>
</Project>
